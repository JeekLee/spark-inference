# envs/inferences/qwen3-30b-a3b/.env.example
#
# Qwen3-30B-A3B-Instruct-2507 (Qwen, MoE 30B total / ~3B active per token,
# non-thinking instruct). BF16 가중치 ~60GB.
# Model card: https://huggingface.co/Qwen/Qwen3-30B-A3B-Instruct-2507
#
# Note: FP8 변형(Qwen3-30B-A3B-Instruct-2507-FP8) 은 GB10(sm_121) + 현 OSS vLLM
# 이미지의 CUTLASS C3x 커널 미지원으로 보류. NGC nvcr.io/nvidia/vllm 또는
# sm_121 포함된 upstream 빌드가 나오면 재시도.
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/path/to/models
# Subdirectory under ${SPARK_MODELS_DIR} for the checkpoint.
# Download:
#   hf download Qwen/Qwen3-30B-A3B-Instruct-2507 \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3-30B-A3B-Instruct-2507
QWEN3_30B_A3B_MODEL_SUBDIR=Qwen3-30B-A3B-Instruct-2507

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
QWEN3_30B_A3B_IMAGE=vllm/vllm-openai:v0.21.0-aarch64-cu129-ubuntu2404

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# QWEN3_30B_A3B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
QWEN3_30B_A3B_GPU_IDS=0
QWEN3_30B_A3B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# BF16 weights ~60GB + KV cache. bge-m3 co-located + GUI 점유 감안해 0.80.
# 단독 운용이면 0.85+ 까지 가능.
QWEN3_30B_A3B_GPU_UTIL=0.80

# Native context = 262144 (256K). 일반 채팅엔 32K 면 충분. KV 캐시 부족하면 줄일 것.
QWEN3_30B_A3B_MAX_LEN=32768
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# - Instruct-2507 은 non-thinking 전용. reasoning-parser 불필요.
# - Tool calling: Hermes 포맷 (qwen3-32b 와 동일 컨벤션).
QWEN3_30B_A3B_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
