# envs/inferences/qwen3-8b/.env.example
#
# Qwen3-8B (Qwen, dense 8B). Hybrid thinking/non-thinking, native ctx 32K.
# Model card: https://huggingface.co/Qwen/Qwen3-8B
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for the Qwen3-8B checkpoint.
# Download:
#   hf download Qwen/Qwen3-8B --local-dir ${SPARK_MODELS_DIR}/Qwen3-8B
QWEN3_8B_MODEL_SUBDIR=Qwen3-8B

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
QWEN3_8B_IMAGE=vllm/vllm-openai:v0.19.1

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# QWEN3_8B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
QWEN3_8B_GPU_IDS=0
QWEN3_8B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# BF16 weights ~16GB. bge-m3 (~0.10) 와 코로케이션 가정. 단독 운용이면
# 0.5+ 까지 올려도 됨 (KV cache headroom 증가).
QWEN3_8B_GPU_UTIL=0.30

# Native context = 32768. chord task 는 1–2K 만 쓰지만 디폴트는 native.
QWEN3_8B_MAX_LEN=32768

VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Default: thinking mode parser + Hermes-style tool calling (32B 와 동일).
#   --reasoning-parser qwen3       — <think>...</think> 블록을 별도 필드로 분리.
#                                    클라이언트에서 chat_template_kwargs.enable_thinking
#                                    로 per-request 토글.
#   --enable-auto-tool-choice      — tool_calls 자동 선택 활성.
#   --tool-call-parser hermes      — Qwen3 의 Hermes 포맷 파서.
#
# 추가 옵션 (필요 시):
#   --quantization fp8             — FP8 가중치 사용 시.
#   --enforce-eager                — CUDA graph 비활성 (디버깅, VRAM 절약).
QWEN3_8B_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser hermes
