# envs/inferences/bge-m3/.env.example
#
# bge-m3 (BAAI, multilingual embedding) served via vLLM `--runner pooling`.
# Model card: https://huggingface.co/BAAI/bge-m3
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for the bge-m3 checkpoint.
# Download:
#   hf download BAAI/bge-m3 --local-dir ${SPARK_MODELS_DIR}/bge-m3
BGE_M3_MODEL_SUBDIR=bge-m3

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. Same image as qwen3-32b — runtime 통일.
# 최신 stable 태그는 https://hub.docker.com/r/vllm/vllm-openai/tags 참고.
BGE_M3_IMAGE=vllm/vllm-openai:v0.19.1

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 필요)
# BGE_M3_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
BGE_M3_GPU_IDS=0
BGE_M3_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# bge-m3 ~2.3GB weights. Co-located with qwen3-32b 인 같은 GPU 라
# 작게 잡기 — qwen3-32b 의 0.85 + 이 값 합이 1.0 미만이어야 OOM 회피.
BGE_M3_GPU_UTIL=0.10

# Native max sequence length (BAAI/bge-m3 spec).
BGE_M3_MAX_LEN=8192

VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Free-form. 일반적으로 비워둠. 필요 시 예:
#   --enforce-eager        — CUDA graph 비활성 (디버깅, VRAM 절약)
BGE_M3_EXTRA_ARGS=
