# envs/inferences/qwen3-vl-30b-a3b/.env.example
#
# Qwen3-VL-30B-A3B-Instruct (Qwen, MoE 30B total / ~3B active per token,
# multimodal: text + image). BF16 가중치 ~62GB.
# Model card: https://huggingface.co/Qwen/Qwen3-VL-30B-A3B-Instruct
#
# 베이스 MoE 백본은 Qwen3-30B-A3B-Instruct-2507 와 동일 → 동일한 chat /
# tool-calling 컨벤션 (hermes parser) 사용. vision tower 추가로 OCR /
# document understanding 가능.
#
# Note: FP8 변형은 GB10(sm_121) + 현 OSS vLLM 이미지의 CUTLASS C3x 커널
# 미지원으로 보류 (text 변형과 동일 이슈).
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/path/to/models
# Subdirectory under ${SPARK_MODELS_DIR} for the checkpoint.
# Download:
#   hf download Qwen/Qwen3-VL-30B-A3B-Instruct \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3-VL-30B-A3B-Instruct
QWEN3_VL_30B_A3B_MODEL_SUBDIR=Qwen3-VL-30B-A3B-Instruct

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
# Qwen3-VL multimodal 지원에 v0.21+ 필요.
QWEN3_VL_30B_A3B_IMAGE=vllm/vllm-openai:v0.21.0-aarch64-cu129-ubuntu2404

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# QWEN3_VL_30B_A3B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
QWEN3_VL_30B_A3B_GPU_IDS=0
QWEN3_VL_30B_A3B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# BF16 weights ~62GB + KV cache + vision encoder. bge-m3 co-located +
# GUI/IDE 점유 감안해 0.60 (≈73GB). 단독 운용이면 0.80+ 까지 가능.
QWEN3_VL_30B_A3B_GPU_UTIL=0.60

# Native context = 262144 (256K). PDF OCR 용도엔 32K 면 충분. KV 캐시
# 부족하면 줄일 것.
QWEN3_VL_30B_A3B_MAX_LEN=32768
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# - Tool calling: Hermes 포맷 (text 변형과 동일).
# - --limit-mm-per-prompt: 한 요청당 최대 이미지 개수. PDF OCR 페이지 단위
#   호출 가정해 image=10 (필요시 조정).
QWEN3_VL_30B_A3B_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes --limit-mm-per-prompt image=10
