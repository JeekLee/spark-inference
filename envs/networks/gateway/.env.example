# envs/networks/gateway/.env.example
#
# spark-inference 단일 게이트웨이 (FastAPI + httpx). chat/embed/audio 모두
# 한 포트로 통합. 라우팅은 매니페스트 기반.
#
# Copy: cp .env.example .env.<target>

GATEWAY_LOG_LEVEL=INFO

# Host bind / port — default-safe loopback. 외부 노출은 0.0.0.0 + 호스트
# 방화벽 규칙 / VPN 별도 점검 후.
GATEWAY_BIND=127.0.0.1
GATEWAY_HOST_PORT=10080

# Bearer 토큰 — 클라이언트가 `Authorization: Bearer <key>` 로 송신.
# 운영 키 생성 예: `openssl rand -hex 24` 또는 `head -c 32 /dev/urandom | base64`
GATEWAY_MASTER_KEY=

# Codex-backed image/prompt worker. 기본 off.
# enable 시 gateway image 안의 `codex exec ...` 를 호출하므로 writable
# ChatGPT/Codex home 을 컨테이너에 secret mount 해야 한다. 메인 ~/.codex 를
# 직접 mount 하기보다 전용 디렉터리에 auth.json 을 복사해서 쓰는 것을 권장:
#
#   GATEWAY_CODEX_ENABLED=true
#   GATEWAY_CODEX_AUTH_DIR=/home/<user>/.codex-spark-inference
#
# 이 경로는 OpenAI Platform vision API 가 아니라 Codex 로그인/사용량을 태우는
# 저용량 fallback 용도다. 대량 batch / long-running agent 용도로 사용하지 말 것.
GATEWAY_CODEX_ENABLED=false
GATEWAY_CODEX_BIN=codex
GATEWAY_CODEX_HOME=/codex-home
GATEWAY_CODEX_TIMEOUT_SECONDS=120
GATEWAY_CODEX_MAX_IMAGE_BYTES=10485760
