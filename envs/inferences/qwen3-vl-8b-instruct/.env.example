# envs/inferences/qwen3-vl-8b-instruct/.env.example
#
# Qwen3-VL-8B-Instruct BF16 (제품명 8B, 모델 카드 표기 9B).
# Model card: https://huggingface.co/Qwen/Qwen3-VL-8B-Instruct
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/path/to/models
# Download a fixed revision before serving:
#   hf download Qwen/Qwen3-VL-8B-Instruct \
#     --revision 0c351dd01ed87e9c1b53cbc748cba10e6187ff3b \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3-VL-8B-Instruct
QWEN3_VL_8B_INSTRUCT_MODEL_SUBDIR=Qwen3-VL-8B-Instruct

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
QWEN3_VL_8B_INSTRUCT_IMAGE=vllm/vllm-openai:v0.21.0-aarch64-cu129-ubuntu2404

# ── GPU allocation ─────────────────────────────────────────────────────
QWEN3_VL_8B_INSTRUCT_GPU_IDS=0
QWEN3_VL_8B_INSTRUCT_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# GB10에서 Shieldstral·bge-m3와 공존한 실측값. 32K 최대 동시성은 1.24배.
QWEN3_VL_8B_INSTRUCT_GPU_UTIL=0.25
QWEN3_VL_8B_INSTRUCT_MAX_LEN=32768
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
QWEN3_VL_8B_INSTRUCT_EXTRA_ARGS=--enable-auto-tool-choice --tool-call-parser hermes
