# envs/audio/chord-progression/.env.example
#
# qwen3-8b 기반 chord progression recommender (thin proxy).
# 로컬 추론 X → GPU 변수 없음. 게이트웨이 통해서만 접근하므로 PORT/AUTH 도 없음.
#
# Copy: cp .env.example .env.<target>

CHORD_PROGRESSION_LOG_LEVEL=INFO

# 호출할 vLLM 백엔드 (같은 docker network 내 service 이름).
CHORD_PROGRESSION_UPSTREAM_URL=http://qwen3-8b:8000
CHORD_PROGRESSION_UPSTREAM_MODEL=qwen3-8b
