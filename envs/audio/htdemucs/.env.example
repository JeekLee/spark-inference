# envs/audio/htdemucs/.env.example
#
# Meta htdemucs 4-stem source separation. v1 은 CPU only — GPU 변수 미사용.
# GPU 활성화 단계에서 HTDEMUCS_GPU_IDS 를 추가 (Dockerfile/compose 도 함께 수정 필요).
#
# Copy: cp .env.example .env.<target>

HTDEMUCS_LOG_LEVEL=INFO

# Host bind / port — default-safe loopback.
HTDEMUCS_BIND=127.0.0.1
HTDEMUCS_HOST_PORT=10083

# Bearer 토큰 — LITELLM_MASTER_KEY 와 동일 값 권장 (단일 키 UX).
AUDIO_MASTER_KEY=
