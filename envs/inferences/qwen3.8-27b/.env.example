# envs/inferences/qwen3.8-27b/.env.example
#
# Qwen3.8-27B FP8 (Qwen, dense 27B + vision encoder, text/image/video).
# Block-scaled FP8 checkpoint ≈ 31GB. Thinking mode on by default.
# Model card: https://huggingface.co/Qwen/Qwen3.8-27B-FP8
# vLLM recipe: https://recipes.vllm.ai/Qwen/Qwen3.8-27B
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
# Host directory holding all model checkpoints.
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for THIS model's checkpoint.
# Download:
#   hf download Qwen/Qwen3.8-27B-FP8 \
#     --revision 017b9c7af6b5689d5dd426a76e0bc077eb5ca20a \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3.8-27B-FP8
QWEN3_8_27B_MODEL_SUBDIR=Qwen3.8-27B-FP8

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. Qwen3_5ForConditionalGeneration 은 v0.19+ 지원,
# multimodal (Qwen3-VL 계열과 동일 경로) 은 v0.21 로 통일.
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
QWEN3_8_27B_IMAGE=vllm/vllm-openai:v0.21.0-aarch64-cu129-ubuntu2404

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# QWEN3_8_27B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices exposed to this container.
# IMPORTANT: count(QWEN3_8_27B_GPU_IDS) MUST equal QWEN3_8_27B_TP_SIZE.
# DGX Spark (GB10) = single GPU host → "0" + TP=1.
QWEN3_8_27B_GPU_IDS=0
QWEN3_8_27B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# Fraction of GPU memory vLLM may use. Lower if you co-locate other GPU
# workloads (e.g. a TEI embedding container) on the same physical GPU.
QWEN3_8_27B_GPU_UTIL=0.60
# Native context = 262144. Hybrid linear attention (48/64 layer) 이라 KV 가
# 작지만 단일 GB10 에서 여유를 두고 128K 로 시작.
QWEN3_8_27B_MAX_LEN=131072
VLLM_LOG_LEVEL=INFO

# ── Kernel workaround (GB10 / sm_121) ──────────────────────────────────
# v0.21 은 block-scaled FP8 GEMM 에 CutlassFp8BlockScaledMMKernel 을 고르는데
# GB10 에서 첫 forward 에 `cutlass_gemm_caller ... Error Internal` 로 죽음.
# 끄면 다음 후보(Marlin FP8 → Triton) 로 폴백.
QWEN3_8_27B_DISABLED_KERNELS=CutlassFp8BlockScaledMMKernel

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Free-form string appended to the vLLM command line. Examples:
#   --reasoning-parser qwen3
#   --enable-auto-tool-choice --tool-call-parser qwen3_coder
#   --quantization fp8
#   --enforce-eager       (skip CUDA graph capture; slower but lower VRAM)
# - reasoning: qwen3 parser → message.reasoning 분리. 요청별 끄기:
#     "chat_template_kwargs": {"enable_thinking": false}
# - tool calling: qwen3_coder (vLLM recipe 권장).
# - 이미지 최대 10장/요청 (v0.21 은 JSON 값만 받음).
# - MTP speculative decoding (checkpoint 내장 draft head, 3 token): GB10 실측
#   decode 7.2 → ~12 tok/s (code 생성 ~19), draft 수락률 ~51%. 대신 min_p /
#   logit_bias 샘플링 파라미터는 무시됨.
QWEN3_8_27B_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --limit-mm-per-prompt '{"image":10}' --speculative-config '{"method":"qwen3_5_mtp","num_speculative_tokens":3}'
