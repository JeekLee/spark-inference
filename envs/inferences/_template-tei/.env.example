# Template env file for a TEI (embedding / reranker) component.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/home/jeek_lee/models
__NAME_UPPER___MODEL_SUBDIR=__NAME__

# ── Image ──────────────────────────────────────────────────────────────
# Hugging Face TEI. Pick a tag with arm64 manifest + your GPU CC support.
# https://github.com/huggingface/text-embeddings-inference/pkgs/container/text-embeddings-inference
# For GB10 (Blackwell sm_100/120 + arm64), verify tag compatibility; if no
# pre-built tag fits, build from source per HF README.
__NAME_UPPER___IMAGE=ghcr.io/huggingface/text-embeddings-inference:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Single GPU slot (TEI does not tensor-parallel). Pin to a physical GPU.
# DGX Spark = single GPU host → "0".
__NAME_UPPER___GPU=0

# ── Runtime tuning ─────────────────────────────────────────────────────
# Max items per /embeddings batch. 1000 matches langchain-openai's default
# OpenAIEmbeddings.chunk_size — keep them aligned to avoid 413 on long docs.
__NAME_UPPER___MAX_BATCH=1000
__NAME_UPPER___MAX_CONCURRENT=2048
