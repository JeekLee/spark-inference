# envs/audio/basic-pitch/.env.example
#
# Spotify BasicPitch polyphonic note transcription. CPU only — GPU 변수 없음.
#
# Copy: cp .env.example .env.<target>

BASIC_PITCH_LOG_LEVEL=INFO

# Host bind / port — default-safe loopback.
BASIC_PITCH_BIND=127.0.0.1
BASIC_PITCH_HOST_PORT=10082

# Bearer 토큰 — LITELLM_MASTER_KEY 와 동일 값 권장 (단일 키 UX).
AUDIO_MASTER_KEY=
