# envs/inferences/qwen3-reranker-0.6b/.env.example
#
# Qwen3-Reranker-0.6B (Qwen, cross-encoder reranker, 0.6B params, ~1.2GB BF16).
# Model card: https://huggingface.co/Qwen/Qwen3-Reranker-0.6B
#
# Qwen3-Reranker 는 causal LM 베이스 reranker — vLLM `--task score` +
# `--hf-overrides` 로 sequence-classification 로 변환해 /v1/rerank 엔드포인트
# 노출. Jina-compat rerank API.
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/path/to/models
# Download:
#   hf download Qwen/Qwen3-Reranker-0.6B \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3-Reranker-0.6B
QWEN3_RERANKER_0_6B_MODEL_SUBDIR=Qwen3-Reranker-0.6B

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
# Qwen3ForSequenceClassification + score task 지원에 v0.9+ 필요.
# 호스트의 다른 vLLM 컴포넌트와 동일 태그로 통일 권장 (현재 v0.21.0).
QWEN3_RERANKER_0_6B_IMAGE=vllm/vllm-openai:v0.21.0-aarch64-cu129-ubuntu2404

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, NGC 계정 + login 필요)
# QWEN3_RERANKER_0_6B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
QWEN3_RERANKER_0_6B_GPU_IDS=0
QWEN3_RERANKER_0_6B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# 0.6B BF16 weights ~1.2GB + KV cache. unified memory 빡빡한 환경 (qwen3-vl
# co-located) 감안 0.05 (~6GB). 단독이면 0.10+ 도 무방.
QWEN3_RERANKER_0_6B_GPU_UTIL=0.05

# Reranker 컨텍스트: 쿼리 + document. 8192 면 일반 RAG 청크엔 충분.
# Qwen3-Reranker native context = 32768.
QWEN3_RERANKER_0_6B_MAX_LEN=8192
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# 추가 flag 가 필요하면 여기에. 예: --enforce-eager (CUDA graph 미사용).
QWEN3_RERANKER_0_6B_EXTRA_ARGS=
