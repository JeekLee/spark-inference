# Template env file for a vLLM component.
# Copy alongside the deployment/ template and replace __NAME_UPPER__.
# Then `cp .env.example .env.<target>` per host and fill real values.

# ── Model location ─────────────────────────────────────────────────────
# Host directory holding all model checkpoints.
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for THIS model's checkpoint.
# Download example: huggingface-cli download <repo> --local-dir ${SPARK_MODELS_DIR}/<subdir>
__NAME_UPPER___MODEL_SUBDIR=__NAME__

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest 자동 매칭 (arm64 포함).
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
__NAME_UPPER___IMAGE=vllm/vllm-openai:v0.19.1

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# __NAME_UPPER___IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices exposed to this container.
# IMPORTANT: count(__NAME_UPPER___GPU_IDS) MUST equal __NAME_UPPER___TP_SIZE.
# DGX Spark (GB10) = single GPU host → "0" + TP=1.
__NAME_UPPER___GPU_IDS=0
__NAME_UPPER___TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# Fraction of GPU memory vLLM may use. Lower if you co-locate other GPU
# workloads (e.g. a TEI embedding container) on the same physical GPU.
__NAME_UPPER___GPU_UTIL=0.9
# Max prompt+generation length. Tune to model's native context window
# unless you need to fit smaller KV cache.
__NAME_UPPER___MAX_LEN=32768
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Free-form string appended to the vLLM command line. Examples:
#   --reasoning-parser qwen3
#   --enable-auto-tool-choice --tool-call-parser qwen3_coder
#   --quantization fp8
#   --enforce-eager       (skip CUDA graph capture; slower but lower VRAM)
__NAME_UPPER___EXTRA_ARGS=
