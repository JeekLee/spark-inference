# envs/inferences/bge-m3/.env.example
#
# bge-m3 (BAAI, multilingual embedding). Dense 1024 + sparse + ColBERT.
# Native max input 8192. ~2.3GB weights — GPU footprint 작아 vLLM 과 동거 OK.
# Model card: https://huggingface.co/BAAI/bge-m3
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for the bge-m3 checkpoint.
# Download:
#   huggingface-cli download BAAI/bge-m3 \
#     --local-dir ${SPARK_MODELS_DIR}/bge-m3
BGE_M3_MODEL_SUBDIR=bge-m3

# ── Image ──────────────────────────────────────────────────────────────
# Hugging Face TEI. arm64 manifest + Blackwell(sm_100/120) 지원 태그를 골라야.
#   태그 목록: https://github.com/huggingface/text-embeddings-inference/pkgs/container/text-embeddings-inference
#
# GB10 호환성 메모:
#   - TEI 는 GPU compute capability 별로 별도 이미지 태그를 제공 (cuda-12.x base
#     + 특정 SM_XX 빌드). Blackwell 지원이 없는 태그를 쓰면 boot 시 PTX/SASS
#     compatibility error.
#   - pre-built 에 없으면 소스 빌드:
#     https://github.com/huggingface/text-embeddings-inference#docker-build
#   - 임시 우회: CPU-only 변종(`cpu-1.x`) — 느리지만 기능 검증 용도.
BGE_M3_IMAGE=ghcr.io/huggingface/text-embeddings-inference:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# 단일 GPU 슬롯 (TEI 는 tensor-parallel 안 함). DGX Spark = "0".
BGE_M3_GPU=0

# ── Runtime tuning ─────────────────────────────────────────────────────
# Max items per /embeddings batch. langchain-openai 의 OpenAIEmbeddings.chunk_size
# default(1000) 와 맞춰 둠 — 한쪽만 바꾸면 장문 문서에서 413 발생.
BGE_M3_MAX_BATCH=1000
BGE_M3_MAX_CONCURRENT=2048
