# openai/gpt-oss-20b — vLLM component env.
# `cp .env.example .env.<target>` per host and fill real values.

# ── Model location ─────────────────────────────────────────────────────
# Host directory holding all model checkpoints.
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for THIS model's checkpoint.
# Download: hf download openai/gpt-oss-20b --local-dir ${SPARK_MODELS_DIR}/gpt-oss-20b --exclude 'original/*' --exclude 'metal/*'
# harmony tiktoken vocab (오프라인 로드, compose 의 TIKTOKEN_ENCODINGS_BASE=/model/tiktoken):
#   mkdir -p ${SPARK_MODELS_DIR}/gpt-oss-20b/tiktoken && for f in o200k_base cl100k_base; do
#     curl -fo ${SPARK_MODELS_DIR}/gpt-oss-20b/tiktoken/$f.tiktoken https://openaipublic.blob.core.windows.net/encodings/$f.tiktoken; done
GPT_OSS_20B_MODEL_SUBDIR=gpt-oss-20b

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest 자동 매칭 (arm64 포함).
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
GPT_OSS_20B_IMAGE=vllm/vllm-openai:v0.19.1

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
# GPT_OSS_20B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices exposed to this container.
# IMPORTANT: count(GPT_OSS_20B_GPU_IDS) MUST equal GPT_OSS_20B_TP_SIZE.
# DGX Spark (GB10) = single GPU host → "0" + TP=1.
GPT_OSS_20B_GPU_IDS=0
GPT_OSS_20B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# Fraction of GPU memory vLLM may use. Lower if you co-locate other GPU
# workloads (e.g. a TEI embedding container) on the same physical GPU.
GPT_OSS_20B_GPU_UTIL=0.3
# Max prompt+generation length. Tune to model's native context window
# unless you need to fit smaller KV cache.
GPT_OSS_20B_MAX_LEN=131072
VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Free-form string appended to the vLLM command line. Examples:
#   --reasoning-parser qwen3
#   --enable-auto-tool-choice --tool-call-parser qwen3_coder
#   --quantization fp8
#   --enforce-eager       (skip CUDA graph capture; slower but lower VRAM)
# --no-enable-prefix-caching: v0.19.1 + GB10(sm_121) 에서 prefix cache hit 시 KV 가 깨져
#   두 번째 요청부터 출력이 망가짐 (temperature=0 에서도 빈 content / harmony 파싱 500). 끄면 정상.
GPT_OSS_20B_EXTRA_ARGS=--no-enable-prefix-caching --reasoning-parser openai_gptoss --enable-auto-tool-choice --tool-call-parser openai
