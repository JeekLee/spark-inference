# envs/inferences/qwen3-32b/.env.example
#
# Qwen3-32B (Qwen, dense 32B). Hybrid thinking/non-thinking, native ctx 32K.
# Model card: https://huggingface.co/Qwen/Qwen3-32B
#
# Copy: cp .env.example .env.<target>   then fill in real values.

# ── Model location ─────────────────────────────────────────────────────
SPARK_MODELS_DIR=/home/jeek_lee/models
# Subdirectory under ${SPARK_MODELS_DIR} for the Qwen3-32B checkpoint.
# Download:
#   huggingface-cli download Qwen/Qwen3-32B \
#     --local-dir ${SPARK_MODELS_DIR}/Qwen3-32B
QWEN3_32B_MODEL_SUBDIR=Qwen3-32B

# ── Image ──────────────────────────────────────────────────────────────
# vLLM OSS Docker Hub. multi-arch manifest (arm64 포함) 자동 매칭.
# 최신 stable: https://hub.docker.com/r/vllm/vllm-openai/tags
QWEN3_32B_IMAGE=vllm/vllm-openai:v0.19.1

# Alternative: NGC (arm64+Blackwell wheel 안정성↑, 단 NGC 계정 + login 필요)
#   docker login nvcr.io ← API key from https://ngc.nvidia.com/setup/api-key
#   browse tags: https://catalog.ngc.nvidia.com/orgs/nvidia/containers/vllm/tags
# QWEN3_32B_IMAGE=nvcr.io/nvidia/vllm:<TAG>

# ── GPU allocation ─────────────────────────────────────────────────────
# Comma-separated GPU indices. count(GPU_IDS) MUST equal TP_SIZE.
# DGX Spark = single GPU → "0" + TP=1.
QWEN3_32B_GPU_IDS=0
QWEN3_32B_TP_SIZE=1

# ── Runtime tuning ─────────────────────────────────────────────────────
# BF16 weights (~64GB) + KV cache fit comfortably in Spark's unified
# memory. 0.85 leaves headroom for a co-located TEI container (bge-m3 등).
# 단독 운용이면 0.9 까지 올려도 됨.
QWEN3_32B_GPU_UTIL=0.85

# Native context = 32768. YaRN 으로 131072 까지 확장 가능 (별도 args 필요).
QWEN3_32B_MAX_LEN=32768

VLLM_LOG_LEVEL=INFO

# ── Extra vLLM CLI flags ───────────────────────────────────────────────
# Default: thinking mode parser + Hermes-style tool calling.
#   --reasoning-parser qwen3       — <think>...</think> 블록을 별도 필드로 분리.
#                                    클라이언트에서 chat_template_kwargs.enable_thinking
#                                    로 per-request 토글.
#   --enable-auto-tool-choice      — tool_calls 자동 선택 활성.
#   --tool-call-parser hermes      — Qwen3 의 Hermes 포맷 파서.
#
# 추가 옵션 (필요 시):
#   --quantization fp8             — FP8 가중치 사용 시.
#   --enforce-eager                — CUDA graph 비활성 (디버깅, VRAM 절약).
#   --rope-scaling '{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":32768}'
#                                    — 128K 컨텍스트 확장 (MAX_LEN 도 같이 131072).
QWEN3_32B_EXTRA_ARGS=--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser hermes
