# envs/audio/madmom-chord/.env.example
#
# Madmom chord recognition. CPU only — GPU 변수 없음.
#
# Copy: cp .env.example .env.<target>

MADMOM_CHORD_LOG_LEVEL=INFO

# Host bind / port — default-safe loopback.
MADMOM_CHORD_BIND=127.0.0.1
MADMOM_CHORD_HOST_PORT=10081

# Bearer 토큰 — LITELLM_MASTER_KEY 와 동일 값 권장 (단일 키 UX).
AUDIO_MASTER_KEY=
