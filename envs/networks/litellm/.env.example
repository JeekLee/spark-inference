# envs/networks/litellm/.env.example
#
# Copy to .env.local / .env.dev / .env.prod on each host.
#
#   cp .env.example .env.local

# Host bind address. 127.0.0.1 = loopback only (host 자신만 접근, LAN/외부는
# connection refused) — 안전한 default.
# 다른 호스트에서도 접근 필요하면 0.0.0.0 (모든 인터페이스) 로 바꾸기 전에:
#   - 방화벽/VPN으로 신뢰 네트워크에만 노출되는지 확인하거나
#   - LITELLM_MASTER_KEY 인증을 활성화 (compose 수정 필요)
# no-auth + 0.0.0.0 조합은 누구나 모델 호출 가능 → 비용/리소스 도용 위험.
SPARK_LITELLM_BIND=127.0.0.1

# Host port to expose the gateway on (bound to ${SPARK_LITELLM_BIND}).
SPARK_LITELLM_PORT=10080

# LiteLLM image tag. main-stable moves but is less volatile than main-latest.
# https://github.com/BerriAI/litellm/releases
LITELLM_IMAGE_TAG=main-stable

# Log level. INFO is fine for prod; DEBUG floods on every request.
LITELLM_LOG=INFO

# NOTE on auth: spark-inference runs the gateway in no-auth mode on a closed
# internal network. The compose file deliberately does NOT pass
# LITELLM_MASTER_KEY — even an empty value makes litellm enforce auth. If you
# need auth, add the env var back to docker-compose.yml; setting it here
# alone won't take effect.
