# Template env file for an audio component.
# Copy alongside the deployment/ template and replace __NAME_UPPER__.
# Then `cp .env.example .env.<target>` per host and fill real values.

# 로그 레벨. INFO / DEBUG / WARNING / ERROR.
__NAME_UPPER___LOG_LEVEL=INFO

# Host bind / port — default-safe loopback. 외부 노출 시 0.0.0.0 으로 바꾸고
# 호스트 방화벽 따로 점검할 것. 포트는 다른 audio 컴포넌트 / LiteLLM(10080)
# 과 충돌하지 않게 부여.
__NAME_UPPER___BIND=127.0.0.1
__NAME_UPPER___HOST_PORT=

# Bearer 토큰 — 클라이언트가 `Authorization: Bearer <key>` 로 송신. LiteLLM
# 의 LITELLM_MASTER_KEY 와 같은 값으로 설정하면 클라이언트는 한 키로 양쪽
# (chat/embed + audio) 다 호출 가능.
AUDIO_MASTER_KEY=

# GPU 가 필요할 때만 아래 줄 활성화:
#   __NAME_UPPER___GPU_IDS=0
# (docker-compose.yml 의 runtime: nvidia 도 같이 켤 것.)
