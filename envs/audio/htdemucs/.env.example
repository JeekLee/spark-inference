# envs/audio/htdemucs/.env.example
#
# Meta htdemucs 4-stem source separation. CUDA 가속 빌드 — runtime: nvidia.
# 게이트웨이 통해서만 접근하므로 컴포넌트 자체에는 PORT/AUTH 변수 없음.
#
# Copy: cp .env.example .env.<target>

HTDEMUCS_LOG_LEVEL=INFO

# GPU 할당 — comma-separated GPU 인덱스. DGX Spark 단일 GPU = "0".
HTDEMUCS_GPU_IDS=0
